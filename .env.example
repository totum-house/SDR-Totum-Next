# =========================================================
# SDR-Next — variáveis de ambiente (template)
# =========================================================
# Copie para .env.local (dev) ou preencha no VPS em /opt/sdr-next/.env (prod).
# NUNCA commitar valores reais.

# ---- Supabase (self-hosted supa.grupototum.com) ----
NEXT_PUBLIC_SUPABASE_URL=https://supa.grupototum.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# ---- OpenWA (rmyndharis/OpenWA, bind 127.0.0.1:2785) ----
# Contrato verificado em 2026-08-24 contra o Swagger da instância real.
OPENWA_URL=http://127.0.0.1:2785
OPENWA_API_KEY=xxx            # header X-API-Key, criado via POST /api/auth/api-keys
OPENWA_SESSION_ID=xxx          # sessão do WhatsApp (criada via POST /api/sessions)
# Secret enviado como header Authorization ao registrar o webhook
# (POST /api/sessions/{id}/webhooks, campo `headers`) — o motor valida
# esse mesmo valor em server.js. Ver apps/openwa/README.md.
OPENWA_WEBHOOK_TOKEN=xxx

# ---- Motor: workspace default (MVP single-tenant por deploy) ----
MOTOR_DEFAULT_WORKSPACE_ID=xxx

# ---- Manus (executor auxiliar, port 8000, já rodando na VPS) ----
MANUS_URL=http://127.0.0.1:8000
MANUS_TOKEN=xxx

# ---- LLM providers (chain: gemini → groq → nvidia) ----
GEMINI_API_KEY=xxx
GROQ_API_KEY=xxx
NVIDIA_API_KEY=xxx

# ---- LLM: retry e circuit breaker (defaults entre parênteses) ----
LLM_MAX_ATTEMPTS=3            # tentativas por provider antes do fallback (3)
LLM_RETRY_BASE_MS=250         # backoff exponencial: base × 2^n (250)
LLM_BREAKER_THRESHOLD=3       # falhas consecutivas até abrir o breaker (3)
LLM_BREAKER_COOLDOWN_MS=60000 # tempo de castigo do provider (60000)

# ---- Motor SDR (Node CJS, PM2, bind 127.0.0.1:3100) ----
MOTOR_PORT=3100
MOTOR_BIND=127.0.0.1
# Endereço extra pra bindar, além de MOTOR_BIND. Necessário quando o OpenWA
# roda em container Docker numa bridge própria (não host network) — o
# container não enxerga 127.0.0.1 do host, é outro namespace de rede.
# Usar o endereço da bridge (ex: `docker inspect openwa-api` → Gateway),
# NUNCA 0.0.0.0. Ver apps/motor/src/server.js e apps/openwa/README.md.
MOTOR_EXTRA_BIND=

# ---- Motor: laço de campanha ----
# false = motor só recebe webhook, não prospecta sozinho. Útil para subir
# uma instância de debug sem risco de ela começar a disparar campanha.
MOTOR_CAMPAIGN_LOOP=true

# true = roda o motor inteiro (flow, cota, jitter, /live) SEM nada sair no
# WhatsApp; o envio vira log. Serve para testar campanha antes de o
# gateway estar pronto e para ensaiar flow novo sem gastar cota do chip.
# A cota continua sendo contada de propósito — o ensaio só vale se o
# comportamento for o mesmo do envio real.
MOTOR_MOCK_SEND=false

# Caminho do rules.yaml. Vazio = packages/config/rules.yaml do próprio
# repo, que é o certo em qualquer deploy que copie o monorepo inteiro.
RULES_YAML_PATH=

# ---- Frontend → Motor ----
# O painel Next fala com o motor por aqui (Route Handlers e SSE proxy).
# Autentica com OPENWA_WEBHOOK_TOKEN, que o motor exige em todos os
# endpoints, não só no webhook.
MOTOR_URL=http://127.0.0.1:3100

# ---- Warm-up WhatsApp (TRAVA DE SEGURANÇA — L11, decisão do Rael) ----
# Schedule do SPEC: dia 1-3 = 2/dia · dia 4-7 = 5/dia · dia 8-14 = 15/dia
# Subir a cota é decisão manual. NÃO é automático de propósito.
WARMUP_ENABLED=true           # false = kill switch, bloqueia QUALQUER envio
WARMUP_DAILY_LIMIT=2          # teto de mensagens outbound por dia (default 2)
#
# Estas duas envs são o teto do DEPLOY. packages/config/rules.yaml e a
# tabela `rules` (que a UI /config escreve) só conseguem ABAIXAR o teto e
# LIGAR o kill switch — nunca o contrário. Ver apps/motor/src/rules.js.

# ---- SSO cookie (obrigatório em qualquer auth Totum) ----
COOKIE_DOMAIN=.grupototum.com
SSO_COOKIE_NAME=sb-access-token
